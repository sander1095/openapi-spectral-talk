# Example .spectral.yml after publishing the ruleset to GitHub Packages
# 
# To use this configuration:
# 1. First publish the ruleset (via GitHub Actions or manually)
# 2. Run: npm install @sander1095/openapi-spectral-ruleset
# 3. Replace the content of .spectral.yml with this example

extends: ["@sander1095/openapi-spectral-ruleset"]

# You can still add custom rules here that are specific to this project
# rules:
#   my-custom-rule:
#     description: "Example custom rule"
#     given: "$.info"
#     severity: warn
#     then:
#       field: version
#       function: truthy
